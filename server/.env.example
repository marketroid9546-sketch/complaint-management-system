# Core
NODE_ENV=production
PORT=5000
CLIENT_URL=https://complaints.mtjfoundation.org

# Database
MONGODB_URI=mongodb+srv://cms_app_user:placeholder_password@cluster0.mtj.mongodb.net/mtj_cms_prod?retryWrites=true&w=majority

# Auth
JWT_SECRET=placeholder_jwt_secret_min_32_bytes_long_string_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=placeholder_refresh_token_secret_min_32_bytes_string
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Encryption at rest for confidential and safeguarding bodies
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object storage for photos and voice notes
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=mtj-cms-attachments-prod
S3_REGION=ap-southeast-1
S3_PUBLIC_BASE_URL=https://media.complaints.mtjfoundation.org

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
MAIL_FROM=redressal@mtjfoundation.org

# WhatsApp (Meta Cloud API)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_ACK=mtj_complaint_ack_v1
WA_TEMPLATE_STATUS=mtj_complaint_update_v1

# Behaviour
TICKET_CODE_PREFIX=MTJ
SLA_CRON_EXPRESSION=*/15 * * * *
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX_SUBMISSIONS=3
ANON_STORE_IP=false
SAFEGUARDING_ALERT_EMAIL=cpo@alhasanain.edu.pk,ceo@mtjfoundation.org
